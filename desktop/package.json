{
  "name": "crossborder-catalog-cowork-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 7777",
    "type-check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "package": "npm run package:win",
    "package:win": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.2",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.29.0"
  },
  "build": {
    "appId": "com.crossborder.catalogcowork",
    "productName": "Cross-border Catalog Cowork",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ]
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7"
  }
}
